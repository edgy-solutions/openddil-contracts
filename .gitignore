# Generated code
gen/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# System / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
